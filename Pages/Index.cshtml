@page
@model IndexModel
@{
    ViewData["Title"] = "Artajerjes Solutions | Equipo tecnológico para empresas";
    ViewData["MetaDescription"] = "Equipo tecnológico para pymes en Argentina y el mundo: web, sistemas a medida, trackeo de envíos y repartos, marketing e integraciones. Trabajamos remoto y también presencial en Argentina.";
    ViewData["Canonical"] = "https://artajerjes.com/";
    var waDiagnostico = IndexModel.GetWhatsAppUrl();
    var waPresupuesto = IndexModel.GetWhatsAppUrl("Hola, quiero pedir un presupuesto para un plan de acompañamiento.");
}

@section Head {
    @if (!string.IsNullOrWhiteSpace(Model.WhatsAppRedirectUrl))
    {
        <meta name="wa-redirect" content="@Model.WhatsAppRedirectUrl" />
    }

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "Artajerjes Solutions",
      "url": "https://artajerjes.com/",
      "logo": "https://artajerjes.com/images/logo-artajerjes.png",
      "description": "Equipo tecnológico para pymes y empresas en Argentina y el mundo. Web, sistemas, trackeo de repartos, marketing e integraciones.",
      "areaServed": [
        { "@@type": "Country", "name": "Argentina" },
        { "@@type": "Place", "name": "Worldwide" }
      ],
      "contactPoint": [{
        "@@type": "ContactPoint",
        "contactType": "sales",
        "availableLanguage": ["es", "en"],
        "telephone": "+5491163615125",
        "email": "Contacto@Artajerjes.com"
      }]
    }
    </script>
}

<!-- Hero -->
<section class="hero" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
        <img src="~/images/hero-comercio.jpg" alt="" width="1600" height="900" fetchpriority="high" />
        <div class="hero-overlay"></div>
        <div class="circuit-bg"></div>
    </div>
    <div class="container hero-content">
        <p class="section-eyebrow">Artajerjes Solutions</p>
        <h1 id="hero-title">Tu equipo tecnológico, estés donde estés</h1>
        <p class="hero-lead">Ordenamos lo digital de tu empresa: web, sistemas, trackeo de repartos y marketing. Un solo equipo, remoto o presencial en Argentina.</p>
        <div class="btn-group">
            <a class="btn btn-primary" href="@waDiagnostico" target="_blank" rel="noopener noreferrer">Pedí tu diagnóstico digital gratis</a>
            <a class="btn btn-secondary" href="#servicios">Ver qué hacemos</a>
        </div>
    </div>
</section>

<img class="circuit-divider" src="~/images/circuit-divider.svg" alt="" width="1200" height="40" />

<!-- ¿Te pasa esto? -->
<section class="section section-dark" id="dolores" aria-labelledby="dolores-title">
    <div class="container">
        <p class="section-eyebrow reveal">Diagnóstico</p>
        <h2 class="section-title reveal" id="dolores-title">¿Te pasa esto?</h2>
        <p class="section-lead reveal">Si te suena familiar, hay trabajo concreto para hacer: recuperar tiempo, ver números claros y vender con menos fricción.</p>
        <div class="grid-pain">
            <article class="pain-card reveal">
                <h3>Web vieja o inexistente</h3>
                <p>Tu página está caída, desactualizada o directamente no existe, y tus clientes no te encuentran.</p>
            </article>
            <article class="pain-card reveal">
                <h3>Pedidos por WhatsApp sin control</h3>
                <p>Vendés por chat, pero los pedidos se pierden entre mensajes, no hay seguimiento claro y nadie sabe en qué quedó cada uno.</p>
            </article>
            <article class="pain-card reveal">
                <h3>Redes abandonadas</h3>
                <p>Publicás de vez en cuando o hace meses que no hay novedades en tus redes.</p>
            </article>
            <article class="pain-card reveal">
                <h3>Excel, papel o sistemas sueltos</h3>
                <p>Gestionás en planillas, papeles o herramientas que no se hablan entre sí.</p>
            </article>
            <article class="pain-card reveal">
                <h3>Poco control operativo</h3>
                <p>Stock, ventas y sucursales sin una mirada clara y al día.</p>
            </article>
            <article class="pain-card reveal">
                <h3>Tareas manuales repetitivas</h3>
                <p>Tu equipo pierde horas en procesos que se podrían automatizar.</p>
            </article>
            <article class="pain-card reveal">
                <h3>Sin a quién recurrir</h3>
                <p>Cuando algo falla en sistemas, no tenés un contacto confiable y rápido.</p>
            </article>
            <article class="pain-card reveal">
                <h3>Proveedores que desaparecen</h3>
                <p>Te dejaron el sistema hecho… y después no contestan más.</p>
            </article>
        </div>
    </div>
</section>

<img class="circuit-divider" src="~/images/circuit-divider.svg" alt="" width="1200" height="40" />

<!-- Qué hacemos -->
<section class="section section-deep" id="servicios" aria-labelledby="servicios-title">
    <div class="circuit-bg" aria-hidden="true"></div>
    <div class="container">
        <p class="section-eyebrow reveal">Servicios</p>
        <h2 class="section-title reveal" id="servicios-title">Qué hacemos</h2>
        <p class="section-lead reveal">Lo armamos con la misma gente que después te acompaña. Arrancás por lo que más necesitás y sumás el resto cuando haga falta.</p>
        <div class="services-grid">
            <article class="service-card reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 20h8M12 18v2"/></svg>
                <div>
                    <h3>Web y landing</h3>
                    <p>Una página que cargue bien en el celular y diga qué vendés, sin que el visitante tenga que adivinar.</p>
                </div>
            </article>
            <article class="service-card reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M3 4h2l2.4 10.2a2 2 0 0 0 2 1.5h7.8a2 2 0 0 0 1.9-1.4L21 8H7"/></svg>
                <div>
                    <h3>Tienda online</h3>
                    <p>Catálogo, pagos y envíos en el mismo lugar. El cliente compra; vos ves el pedido sin pelearte con el Excel.</p>
                </div>
            </article>
            <article class="service-card reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M8 11h8M8 15h5"/></svg>
                <div>
                    <h3>Web como suscripción</h3>
                    <p>Cuota mensual con hosting y mantenimiento incluidos. Si se rompe algo, lo atendemos nosotros.</p>
                </div>
            </article>
            <article class="service-card reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15v-4M12 15V8M16 15v-6"/></svg>
                <div>
                    <h3>Sistemas de gestión a medida</h3>
                    <p>Stock, ventas, sucursales y reportes según cómo operás vos. Remoto para cualquier país; en Argentina también vamos si hace falta.</p>
                </div>
            </article>
            <article class="service-card reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8h10M7 12h6"/><circle cx="17" cy="16" r="3"/><path d="M4 4h16v9H4z"/></svg>
                <div>
                    <h3>Integraciones y automatización</h3>
                    <p>WhatsApp, pagos y facturación hablando entre sí. Menos copiar y pegar; más tiempo en la calle o en el local.</p>
                </div>
            </article>
            <article class="service-card reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.2 4.5L19 8.2l-3.5 3.4.8 4.9L12 14.8 7.7 16.5l.8-4.9L5 8.2l4.8-.7z"/></svg>
                <div>
                    <h3>Marketing digital</h3>
                    <p>Instagram, Facebook, TikTok y LinkedIn. Publicamos y medimos; si una campaña no trae consultas, la cortamos.</p>
                </div>
            </article>
            <article class="service-card reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15v-4M12 15V8M16 15v-6"/></svg>
                <div>
                    <h3>Trackeo</h3>
                    <p>Dónde va cada envío, cada reparto y cada persona en la calle. En el mapa, no en un grupo de WhatsApp.</p>
                </div>
            </article>
            <article class="service-card reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a5 5 0 0 1 5 5v1h1a3 3 0 0 1 0 6h-1v1a5 5 0 0 1-10 0v-1H6a3 3 0 0 1 0-6h1V8a5 5 0 0 1 5-5z"/></svg>
                <div>
                    <h3>Consultoría y capacitación</h3>
                    <p>Te decimos qué conviene comprar o armar, y le enseñamos a tu equipo a usarlo. Sin vueltas.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<img class="circuit-divider" src="~/images/circuit-divider.svg" alt="" width="1200" height="40" />

<!-- Equipo de asistencia -->
<section class="section section-dark" id="asistencia" aria-labelledby="asistencia-title">
    <div class="container">
        <p class="section-eyebrow reveal">Acompañamiento</p>
        <h2 class="section-title reveal" id="asistencia-title">Equipo de asistencia</h2>
        <p class="section-lead reveal">Quedamos cerca después de entregar. La misma gente que armó tu web o tu sistema te atiende cuando algo falla o cuando querés sumar algo nuevo.</p>
        <div class="why-grid">
            <article class="why-item reveal">
                <h3>Un solo equipo</h3>
                <p>Web, sistemas, marketing y trackeo con las mismas caras. No tenés que recontar tu negocio cada vez.</p>
            </article>
            <article class="why-item reveal">
                <h3>Remoto y presencial</h3>
                <p>Videollamada desde cualquier país. En Argentina vamos al local o al depósito si el trabajo lo pide.</p>
            </article>
            <article class="why-item reveal">
                <h3>Abono con respaldo</h3>
                <p>Cuota mensual, horas incluidas y plazos de respuesta por escrito.</p>
            </article>
            <article class="why-item reveal">
                <h3>Escalá sin cambiar</h3>
                <p>Podés empezar por una landing y más adelante pedir un sistema de gestión. Seguís con nosotros.</p>
            </article>
        </div>
    </div>
</section>

<img class="circuit-divider" src="~/images/circuit-divider.svg" alt="" width="1200" height="40" />

<!-- Cómo trabajamos -->
<section class="section section-deep" id="como-trabajamos" aria-labelledby="como-title">
    <div class="container">
        <p class="section-eyebrow reveal">Proceso</p>
        <h2 class="section-title reveal" id="como-title">Cómo trabajamos</h2>
        <p class="section-lead reveal">Cuatro pasos. Si en el diagnóstico no hay caso, te lo decimos. Todo puede hacerse por videollamada.</p>
        <div class="timeline">
            <article class="timeline-step reveal">
                <div class="timeline-dot" aria-hidden="true">1</div>
                <div>
                    <h3>Diagnóstico</h3>
                    <p>Miramos web, sistemas, pedidos y operación. Anotamos qué duele de verdad.</p>
                </div>
            </article>
            <article class="timeline-step reveal">
                <div class="timeline-dot" aria-hidden="true">2</div>
                <div>
                    <h3>Plan</h3>
                    <p>Ordenamos por impacto. Primero lo que destraba ventas o stock; el resto después.</p>
                </div>
            </article>
            <article class="timeline-step reveal">
                <div class="timeline-dot" aria-hidden="true">3</div>
                <div>
                    <h3>Implementación</h3>
                    <p>Construimos mientras tu equipo sigue vendiendo. Coordinamos ventanas cortas para pruebas.</p>
                </div>
            </article>
            <article class="timeline-step reveal">
                <div class="timeline-dot" aria-hidden="true">4</div>
                <div>
                    <h3>Acompañamiento</h3>
                    <p>Quedamos a mano: ajustes, capacitación y lo que se rompa en el día a día.</p>
                </div>
            </article>
        </div>
        <p class="timeline-note reveal">¿Estás en otra ciudad o país? Avanzamos por videollamada.</p>
    </div>
</section>

<img class="circuit-divider" src="~/images/circuit-divider.svg" alt="" width="1200" height="40" />

