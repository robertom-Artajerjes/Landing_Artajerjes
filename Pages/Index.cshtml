<!-- CTA final + contacto -->
<section class="section section-black" id="contacto" aria-labelledby="contacto-title">
    <div class="circuit-bg" aria-hidden="true"></div>
    <div class="container">
        <p class="section-eyebrow reveal">Contacto</p>
        <h2 class="section-title reveal" id="contacto-title">Pedí tu diagnóstico digital gratis</h2>
        <p class="section-lead reveal">Contanos tu empresa y te proponemos el siguiente paso. También podés escribirnos directo por WhatsApp.</p>

        <div class="contact-layout">
            <form method="post" asp-page-handler="Contacto" class="contact-form reveal" novalidate>
                @if (!string.IsNullOrWhiteSpace(Model.WhatsAppRedirectUrl))
                {
                    <p class="form-success" role="status">Gracias. Te estamos abriendo WhatsApp para continuar la conversación.</p>
                }

                <div class="form-row">
                    <div class="field">
                        <label asp-for="Contacto.Nombre"></label>
                        <input asp-for="Contacto.Nombre" autocomplete="name" />
                        <span class="error" asp-validation-for="Contacto.Nombre"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Contacto.Empresa"></label>
                        <input asp-for="Contacto.Empresa" autocomplete="organization" />
                        <span class="error" asp-validation-for="Contacto.Empresa"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="field">
                        <label asp-for="Contacto.Rubro"></label>
                        <input asp-for="Contacto.Rubro" list="rubros-sugeridos" />
                        <datalist id="rubros-sugeridos">
                            <option value="Comercio"></option>
                            <option value="Distribuidora / Mayorista"></option>
                            <option value="Supermercado"></option>
                            <option value="Industria"></option>
                            <option value="Corralón"></option>
                            <option value="Clínica / Salud"></option>
                            <option value="Transporte / Logística"></option>
                            <option value="Agro"></option>
                            <option value="Servicios"></option>
                            <option value="Otro"></option>
                        </datalist>
                        <span class="error" asp-validation-for="Contacto.Rubro"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Contacto.Pais"></label>
                        <input asp-for="Contacto.Pais" autocomplete="country-name" />
                        <span class="error" asp-validation-for="Contacto.Pais"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="field">
                        <label asp-for="Contacto.Ciudad"></label>
                        <input asp-for="Contacto.Ciudad" autocomplete="address-level2" />
                        <span class="error" asp-validation-for="Contacto.Ciudad"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Contacto.Telefono">Teléfono (con código de país)</label>
                        <input asp-for="Contacto.Telefono" type="tel" autocomplete="tel" placeholder="+54 9 11 ..." />
                        <span class="error" asp-validation-for="Contacto.Telefono"></span>
                    </div>
                </div>

                <div class="field">
                    <label asp-for="Contacto.Necesidad"></label>
                    <textarea asp-for="Contacto.Necesidad" rows="4" placeholder="Web, sistema de gestión, trackeo, marketing..."></textarea>
                    <span class="error" asp-validation-for="Contacto.Necesidad"></span>
                </div>

                <button class="btn btn-primary" type="submit">Enviar y continuar por WhatsApp</button>
            </form>

            <aside class="contact-aside reveal">
                <div class="info-card">
                    <h3>WhatsApp</h3>
                    <p><a href="@waDiagnostico" target="_blank" rel="noopener noreferrer">@IndexModel.TelefonoDisplay</a></p>
                    <a class="btn btn-secondary" href="@waDiagnostico" target="_blank" rel="noopener noreferrer">Escribinos ahora</a>
                </div>
                <div class="info-card">
                    <h3>Datos de contacto</h3>
                    <p>Teléfono: <a href="tel:@IndexModel.TelefonoHref">@IndexModel.TelefonoDisplay</a></p>
                    <p>Email: <a href="mailto:@IndexModel.Email">@IndexModel.Email</a></p>
                    <p>Dirección: [DIRECCIÓN]</p>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
